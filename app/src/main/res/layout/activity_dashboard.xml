<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DashboardActivity">

    <!-- Main Content with CoordinatorLayout -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/dashboard_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dashboard_background">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="@color/dashboard_background"
                app:statusBarScrim="@color/dashboard_background"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <!-- Parallax Header Content -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_header_expanded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="32dp"
                    android:paddingBottom="60dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.5">



                    <!-- Progress Section -->
                    <!-- Secondary Progress (Outside) -->
                    <ProgressBar
                        android:id="@+id/progress_bar_circle_secondary"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/dashboard_progress_circle_secondary"
                        app:layout_constraintTop_toTopOf="@id/progress_bar_circle"
                        app:layout_constraintBottom_toBottomOf="@id/progress_bar_circle"
                        app:layout_constraintStart_toStartOf="@id/progress_bar_circle"
                        app:layout_constraintEnd_toEndOf="@id/progress_bar_circle" />

                    <ProgressBar
                        android:id="@+id/progress_bar_circle"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/dashboard_progress_circle"
                        android:layout_marginTop="32dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/text_progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/dashboard_text_navy"
                        app:layout_constraintStart_toStartOf="@id/progress_bar_circle"
                        app:layout_constraintEnd_toEndOf="@id/progress_bar_circle"
                        app:layout_constraintTop_toTopOf="@id/progress_bar_circle"
                        app:layout_constraintBottom_toBottomOf="@id/progress_bar_circle"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:text="COMPLETE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:textColor="@color/dashboard_grey"
                        app:layout_constraintTop_toBottomOf="@id/text_progress_percent"
                        app:layout_constraintStart_toStartOf="@id/progress_bar_circle"
                        app:layout_constraintEnd_toEndOf="@id/progress_bar_circle" />

                    <TextView
                        android:id="@+id/text_summary_line1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textSize="18sp"
                        android:textColor="@color/dashboard_text_navy"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@id/progress_bar_circle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/text_daily_goal_label"
                        android:text="Your daily reminder goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#992C3E50"
                        app:layout_constraintTop_toBottomOf="@id/text_summary_line1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Calendar Header -->
                    <TextView
                        android:id="@+id/text_month_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Month Year"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/dashboard_section_header_color"
                        android:layout_marginTop="24dp"
                        android:layout_marginStart="24dp"
                        app:layout_constraintTop_toBottomOf="@id/text_daily_goal_label"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/text_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View all"
                        android:textSize="12sp"
                        android:textColor="@color/dashboard_section_header_color"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintBottom_toBottomOf="@id/text_month_year"
                        app:layout_constraintTop_toTopOf="@id/text_month_year"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Date Scroller -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_dates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipToPadding="false"
                        android:paddingHorizontal="24dp"
                        android:layout_marginTop="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/text_month_year" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Pinned Content: Toolbar/Sticky Header AND Timeline Header -->
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="pin"
                    android:minHeight="80dp"
                    android:padding="0dp"
                    app:contentInsetStart="0dp"
                    android:background="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">



                        <!-- Sticky Header Card (Collapsed) -->
                        <LinearLayout
                            android:id="@+id/layout_header_collapsed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:background="@drawable/bg_header_collapsed"
                            android:elevation="12dp"
                            android:visibility="invisible"
                            android:alpha="0"
                            android:orientation="horizontal"
                            android:gravity="center_vertical|start"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/text_header_count"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/shape_hollow_circle_teal"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="@color/dashboard_text_navy"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/text_header_count_done"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="16dp"
                                android:background="@drawable/shape_hollow_circle_pink"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="@color/dashboard_text_navy"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/text_header_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="16dp"
                                android:minWidth="80dp"
                                android:paddingHorizontal="12dp"
                                android:background="@drawable/shape_hollow_pill_yellow"
                                android:gravity="center"
                                android:text="0%"
                                android:textColor="@color/dashboard_text_navy"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical"
                                android:gravity="center_vertical">

                                <!-- Legend Items -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="3dp"
                                        android:background="#48C0B0" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="Remaining"
                                        android:textSize="10sp"
                                        android:textColor="@color/dashboard_text_navy"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="3dp"
                                        android:background="#fe8da1" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="Completed"
                                        android:textSize="10sp"
                                        android:textColor="@color/dashboard_text_navy"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="3dp"
                                        android:background="#FFD54F" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="Progress/Wait"
                                        android:textSize="10sp"
                                        android:textColor="@color/dashboard_text_navy"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.appcompat.widget.Toolbar>

                <!-- Timeline Header (Pinned at Bottom) -->
                <TextView
                    android:id="@+id/text_timeline_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/todays_timeline"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/dashboard_section_header_color"
                    android:layout_gravity="bottom"
                    app:layout_collapseMode="pin"
                    android:background="@color/dashboard_background"
                    android:paddingVertical="16dp"
                    android:paddingStart="24dp" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Tasks List (Scrolling Body) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_tasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:paddingBottom="100dp"
                android:paddingTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/text_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_reminders_today"
                android:textSize="18sp"
                android:textColor="@color/dashboard_grey"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:visibility="gone"
                android:layout_marginTop="32dp" />
        </FrameLayout>

    <!-- Title and Menu Overlay (Fixed) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/title_dashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/dashboard_text_navy"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Menu"
            android:padding="12dp"
            android:src="@drawable/ic_menu"
            app:tint="@color/dashboard_text_navy"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintBottom_toBottomOf="@id/title_dashboard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/title_dashboard" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_dashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:backgroundTint="@color/dashboard_matte_teal"
        app:tint="@android:color/white"
        android:src="@drawable/ic_add"
        android:layout_gravity="bottom|end" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Drawer Container with Footer -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_drawer_rounded">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:itemHorizontalPadding="32dp"
            app:itemVerticalPadding="12dp"
            app:itemTextColor="@color/drawer_navy"
            app:itemTextAppearance="@style/DrawerMenuTextStyle"
            app:itemBackground="@drawable/drawer_menu_item_background"
            app:headerLayout="@layout/drawer_header_premium"
            app:menu="@menu/drawer_menu" />

        <!-- Footer at bottom -->
        <include
            android:id="@+id/drawer_footer_include"
            layout="@layout/drawer_footer" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
