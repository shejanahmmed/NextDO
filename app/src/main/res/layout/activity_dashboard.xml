<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_content_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    tools:context=".DashboardActivity">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="?android:attr/windowBackground"
                app:statusBarScrim="?android:attr/windowBackground"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_header_expanded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="60dp"
                    android:paddingBottom="60dp"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.5">



                    <!-- Progress Section -->


                    <ProgressBar
                        android:id="@+id/progress_bar_circle"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/dashboard_progress_circle"
                        android:layout_marginTop="32dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/text_progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintStart_toStartOf="@id/progress_bar_circle"
                        app:layout_constraintEnd_toEndOf="@id/progress_bar_circle"
                        app:layout_constraintTop_toTopOf="@id/progress_bar_circle"
                        app:layout_constraintBottom_toBottomOf="@id/progress_bar_circle"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:text="COMPLETE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintTop_toBottomOf="@id/text_progress_percent"
                        app:layout_constraintStart_toStartOf="@id/progress_bar_circle"
                        app:layout_constraintEnd_toEndOf="@id/progress_bar_circle" />

                    <TextView
                        android:id="@+id/text_summary_line1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textSize="18sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@id/progress_bar_circle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/text_daily_goal_label"
                        android:text="Your daily reminder goal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#992C3E50"
                        app:layout_constraintTop_toBottomOf="@id/text_summary_line1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Calendar Header -->
                    <TextView
                        android:id="@+id/text_month_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Month Year"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="24dp"
                        android:layout_marginStart="24dp"
                        app:layout_constraintTop_toBottomOf="@id/text_daily_goal_label"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/text_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View all"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintBottom_toBottomOf="@id/text_month_year"
                        app:layout_constraintTop_toTopOf="@id/text_month_year"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Date Scroller -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_dates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipToPadding="false"
                        android:paddingHorizontal="24dp"
                        android:layout_marginTop="16dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@id/text_month_year" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Pinned Content: Toolbar/Sticky Header AND Timeline Header -->
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    app:layout_collapseMode="pin"
                    android:padding="0dp"
                    app:contentInsetStart="0dp"
                    android:background="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">



                        <LinearLayout
                            android:id="@+id/layout_header_collapsed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="45dp"
                            android:layout_marginBottom="0dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:background="@drawable/bg_header_collapsed"
                            android:visibility="invisible"
                            android:alpha="0"
                            android:orientation="horizontal"
                            android:gravity="center_vertical|start"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp">

                            <TextView
                                android:id="@+id/text_header_count"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/shape_hollow_circle_teal"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/text_header_count_done"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/shape_hollow_circle_pink"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/text_header_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="50dp"
                                android:layout_marginStart="12dp"
                                android:minWidth="80dp"
                                android:paddingHorizontal="12dp"
                                android:background="@drawable/shape_hollow_pill_yellow"
                                android:gravity="center"
                                android:text="0%"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:orientation="vertical"
                                android:gravity="center_vertical">

                                <!-- Legend Items -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="3dp"
                                        android:background="#48C0B0" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="Remaining"
                                        android:singleLine="true"
                                        android:textSize="8sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="3dp"
                                        android:background="#fe8da1" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="Completed"
                                        android:singleLine="true"
                                        android:textSize="8sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">
                                    <View
                                        android:layout_width="12dp"
                                        android:layout_height="3dp"
                                        android:background="#FFD54F" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="Upcoming"
                                        android:singleLine="true"
                                        android:textSize="8sp"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.appcompat.widget.Toolbar>

                <TextView
                    android:id="@+id/text_timeline_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/todays_timeline"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_gravity="bottom"
                    app:layout_collapseMode="pin"
                    android:background="?android:attr/windowBackground"
                    android:paddingVertical="16dp"
                    android:paddingStart="24dp" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Tasks List (Scrolling Body) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.shejan.nextdo.AppBarFirstScrollBehavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_tasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="24dp"
                android:paddingBottom="100dp"
                android:paddingTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Empty State -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/empty_state_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/no_reminders_today"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

    <!-- Title Overlay (Fixed at same height as other pages) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        android:elevation="8dp">

        <TextView
            android:id="@+id/title_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Dashboard"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:letterSpacing="-0.02"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="?android:attr/windowBackground"
        android:elevation="12dp"
        android:paddingHorizontal="8dp">

        <!-- Dashboard -->
        <LinearLayout
            android:id="@+id/nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Dashboard" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="9sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Reminders -->
        <LinearLayout
            android:id="@+id/nav_reminders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_alarm"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Reminders" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminders"
                android:textSize="9sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Add Task (Center raised button) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_add"
                android:backgroundTint="?attr/colorOnSurface"
                app:tint="@android:color/white"
                app:fabSize="mini"
                android:contentDescription="Add Task" />
        </LinearLayout>

        <!-- Completed -->
        <LinearLayout
            android:id="@+id/nav_completed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_check_circle"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Completed" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textSize="9sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Settings" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="9sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

