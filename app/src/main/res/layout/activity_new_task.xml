<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    tools:context=".NewTaskActivity">

    <!-- Back arrow -->
    <ImageView
        android:id="@+id/back_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_back"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Minimal style header -->
    <TextView
        android:id="@+id/add_task_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_task"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/back_arrow"
        app:layout_constraintTop_toTopOf="@id/back_arrow"
        app:layout_constraintBottom_toBottomOf="@id/back_arrow" />



    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@id/add_task_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- Title Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp" />

                <!-- Input Box Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp">

                    <EditText
                        android:id="@+id/edit_title"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:hint="Enter task title"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/hint_text_color"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Description Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp" />

                <!-- Input Box Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp">

                    <EditText
                        android:id="@+id/edit_description"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@android:color/transparent"
                        android:hint="Enter description (optional)"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/hint_text_color"
                        android:textSize="16sp"
                        android:gravity="top" />
                </LinearLayout>
            </LinearLayout>

            <!-- Reminder Type Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reminder Type"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp" />

                <!-- Options Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_minimal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <CheckBox
                            android:id="@+id/checkbox_type_notification"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/bg_reminder_type_button"
                            android:textColor="@color/black_white_toggle_text"
                            android:layout_marginEnd="8dp"
                            android:checked="true"
                            android:paddingTop="24dp"
                            android:paddingBottom="24dp"
                            android:text="Notification"
                            android:textSize="11sp"
                            android:drawableTop="@drawable/ic_notification"
                            android:drawableTint="@color/black_white_toggle_text"
                            android:drawablePadding="4dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <CheckBox
                            android:id="@+id/checkbox_type_alarm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/bg_reminder_type_button"
                            android:textColor="@color/black_white_toggle_text"
                            android:layout_marginEnd="8dp"
                            android:paddingTop="24dp"
                            android:paddingBottom="24dp"
                            android:text="Alarm"
                            android:textSize="11sp"
                            android:drawableTop="@drawable/ic_alarm"
                            android:drawableTint="@color/black_white_toggle_text"
                            android:drawablePadding="4dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />

                        <CheckBox
                            android:id="@+id/checkbox_type_voice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/bg_reminder_type_button"
                            android:textColor="@color/black_white_toggle_text"
                            android:paddingTop="24dp"
                            android:paddingBottom="24dp"
                            android:text="Voice"
                            android:textSize="11sp"
                            android:drawableTop="@drawable/ic_mic"
                            android:drawableTint="@color/black_white_toggle_text"
                            android:drawablePadding="4dp"
                            android:focusable="false"
                            android:focusableInTouchMode="false" />
                    </LinearLayout>

                    <!-- Voice Preview Box (Initially Hidden) -->
                    <LinearLayout
                        android:id="@+id/voice_preview_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_card_minimal"
                        android:padding="16dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <com.shejan.nextdo.EqualizerView
                            android:id="@+id/voice_equalizer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Listen"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:id="@+id/btn_play_voice"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_play"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="8dp"
                            android:contentDescription="Play voice preview" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Priority & Repeat Card -->


            <!-- Repeat Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Repeat"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp"
                    android:drawableStart="@drawable/ic_repeat"
                    android:drawablePadding="8dp"
                    android:drawableTint="#99a0f5" />

                <!-- Input Box Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/text_repeat"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="NONE"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:drawablePadding="8dp"
                        app:drawableEndCompat="@drawable/ic_arrow_down"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </LinearLayout>

            <!-- Reminder Card - Border Removed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date &amp; Time"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="16dp"
                    android:drawableStart="@drawable/ic_clock"
                    android:drawablePadding="8dp"
                    android:drawableTint="#8cdcfa" />

                <com.shejan.nextdo.WarmReminderView
                    android:id="@+id/warm_reminder_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Material style save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="SET REMINDER"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                app:backgroundTint="@color/action_button_color"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>
    </ScrollView>



    <!-- Overlay for blur effect -->
    <View
        android:id="@+id/blur_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:elevation="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>