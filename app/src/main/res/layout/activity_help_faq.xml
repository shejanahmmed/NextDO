<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fitsSystemWindows="false">

    <!-- === Gradient Header Banner (same style as Settings page) === -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_settings_header"
        android:orientation="vertical"
        android:gravity="top"
        android:fitsSystemWindows="true"
        android:elevation="12dp"
        android:translationZ="12dp">

        <!-- Centered Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help &amp; FAQ"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:letterSpacing="-0.02" />

        </LinearLayout>

    </LinearLayout>

    <!-- === Scrollable Content === -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="90dp"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FREQUENTLY ASKED QUESTIONS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="?attr/colorSecondary"
                android:layout_marginBottom="14dp" />

            <!-- ── FAQ Item 1 ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="top">

                    <!-- Icon badge -->
                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="➕"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="How do I create a new task?"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tap the ＋ button at the bottom right of the screen. Enter your task details and tap Save."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingMultiplier="1.5" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FAQ Item 2 ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="top">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="🗑️"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="How do I delete a task?"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Swipe the task to the left to move it to the Recycle Bin. You can also long-press a task to open a context menu with more options."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingMultiplier="1.5" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FAQ Item 3 ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="top">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="✏️"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="How do I edit a task?"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tap on any task card to open the edit screen, or swipe it to the right."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingMultiplier="1.5" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FAQ Item 4 ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="top">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="🎨"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Can I change the app theme?"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Yes! Go to Settings and choose between Light, Dark, or System default themes."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingMultiplier="1.5" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FAQ Item 5 ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="top">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="✅"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Where are my completed tasks?"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Completed tasks are moved to the 'Completed Tasks' page. They are automatically deleted after 15 days."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingMultiplier="1.5" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FAQ Item 6 ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="top">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:text="♻️"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="How does the Recycle Bin work?"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Deleted tasks go to the Recycle Bin where they can be restored or permanently deleted. Items are auto-purged after 30 days."
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:lineSpacingMultiplier="1.5" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
