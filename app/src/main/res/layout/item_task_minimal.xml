<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">

    <!-- Task Card -->
    <LinearLayout
        android:id="@+id/task_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_task_card_home"
        android:padding="20dp"
        android:elevation="4dp"
        android:outlineSpotShadowColor="?attr/colorPrimary"
        android:outlineAmbientShadowColor="?attr/colorPrimary"
        android:layout_marginBottom="6dp"
        android:layout_marginHorizontal="2dp">

        <!-- Top Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Task Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Title"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <LinearLayout
                    android:id="@+id/details_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/text_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:00 AM"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:textAllCaps="true"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/text_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WORK"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:textAllCaps="true"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Icons (Priority, Repeat) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <ImageView
                    android:id="@+id/icon_repeat"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_repeat"
                    app:tint="#000000"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Expandable Content (Description + Buttons) -->
        <LinearLayout
            android:id="@+id/layout_expandable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_task_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task description goes here"
                android:textSize="14sp"
                android:textColor="#000000"
                android:fontFamily="sans-serif"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:id="@+id/layout_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="34dp"
                    android:text="Edit"
                    android:textSize="10sp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="#000000"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_task"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="34dp"
                    android:text="Delete"
                    android:textSize="10sp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="#000000"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="34dp"
                    android:text="Done"
                    android:textSize="10sp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#000000"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
