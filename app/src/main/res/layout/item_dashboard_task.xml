<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Timeline Line -->
    <View
        android:id="@+id/timeline_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="8dp" />

    <View
        android:id="@+id/timeline_dot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_dashboard_card_blue"
        app:layout_constraintStart_toStartOf="@id/timeline_line"
        app:layout_constraintEnd_toEndOf="@id/timeline_line"
        app:layout_constraintTop_toTopOf="@id/card_container"
        app:layout_constraintBottom_toBottomOf="@id/card_container" />

    <!-- Hollow Circle Indicator (Initially Hidden) -->
    <ImageView
        android:id="@+id/hollow_circle_indicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/hollow_circle_indicator"
        android:scaleType="center"
        android:visibility="gone"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="@id/timeline_dot"
        app:layout_constraintEnd_toEndOf="@id/timeline_dot"
        app:layout_constraintTop_toTopOf="@id/timeline_dot"
        app:layout_constraintBottom_toBottomOf="@id/timeline_dot" />

    <!-- Card -->
    <RelativeLayout
        android:id="@+id/card_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card_blue"
        android:padding="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toEndOf="@id/timeline_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="24dp">

        <!-- Checkmark (Centered Vertically) -->
        <ImageView
            android:id="@+id/img_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/dashboard_text_navy"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:visibility="gone" />

        <!-- Delete Icon (Top-Right Corner, shown when expanded) -->
        <ImageView
            android:id="@+id/btn_delete_task"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/dashboard_text_navy"
            android:alpha="0.6"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:padding="2dp"
            android:visibility="gone"
            android:contentDescription="Delete task" />

        <!-- Content Wrapper -->
        <LinearLayout
            android:id="@+id/content_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toStartOf="@id/img_check"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/text_task_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Task Title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dashboard_text_navy" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:alpha="0.8">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/dashboard_text_navy"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/text_task_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:00 AM"
                    android:textSize="14sp"
                    android:textColor="@color/dashboard_text_navy" />

                <TextView
                    android:id="@+id/text_reminder_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pill"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dashboard_text_navy"
                    android:layout_marginStart="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Expandable Content (Description + Buttons) -->
            <LinearLayout
                android:id="@+id/layout_expandable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_task_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Task description goes here"
                    android:textSize="14sp"
                    android:textColor="@color/dashboard_text_navy"
                    android:layout_marginTop="8dp"
                    android:alpha="0.7" />

                <LinearLayout
                    android:id="@+id/layout_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="end">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Edit"
                        android:textSize="12sp"
                        android:backgroundTint="@android:color/transparent"
                        android:textColor="@color/dashboard_text_navy"
                        app:strokeColor="@color/dashboard_text_navy"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Delete"
                        android:textSize="12sp"
                        android:backgroundTint="@android:color/transparent"
                        android:textColor="@color/dashboard_text_navy"
                        app:strokeColor="@color/dashboard_text_navy"
                        app:strokeWidth="1dp"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_done"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Done"
                        android:textSize="12sp"
                        android:backgroundTint="@color/dashboard_text_navy"
                        android:textColor="@android:color/white"
                        app:cornerRadius="8dp"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
